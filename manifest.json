{
  "manifest_version": 3,
  "name": "Nói Đi – Luyện nói với AI Studio",
  "short_name": "Nói Đi",
  "version": "1.0.0",
  "description": "Biến Google AI Studio thành phòng luyện nói: giám khảo AI hỏi, bạn nói, chấm điểm mức giống người bản xứ. 8 ngôn ngữ.",
  "homepage_url": "https://github.com/phihung0131/noi-di",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "dist/icons/icon-16.png",
    "32": "dist/icons/icon-32.png",
    "48": "dist/icons/icon-48.png",
    "128": "dist/icons/icon-128.png"
  },
  "action": {
    "default_title": "Nói Đi – Luyện nói với AI Studio",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "dist/icons/icon-16.png",
      "32": "dist/icons/icon-32.png",
      "48": "dist/icons/icon-48.png",
      "128": "dist/icons/icon-128.png"
    }
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://aistudio.google.com/*"
  ],
  "background": {
    "service_worker": "dist/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://aistudio.google.com/*"
      ],
      "js": [
        "dist/tap.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://aistudio.google.com/*"
      ],
      "js": [
        "dist/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "dist/fonts/*",
        "dist/icons/*",
        "dist/donate-qr.jpg"
      ],
      "matches": [
        "https://aistudio.google.com/*"
      ]
    }
  ]
}